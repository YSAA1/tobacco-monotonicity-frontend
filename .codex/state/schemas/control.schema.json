{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/control.schema.json",
  "title": "Codex Harness Control State",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "project",
    "tasks",
    "updated_at"
  ]
}
